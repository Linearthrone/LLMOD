<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Obsidian Field — base color tokens (themes override these) -->
    <Color x:Key="PrimaryColor">#5B8A8A</Color>
    <Color x:Key="PrimaryLightColor">#7AAFAF</Color>
    <Color x:Key="PrimaryDarkColor">#3D5C5C</Color>
    <Color x:Key="AccentColor">#7AAFAF</Color>
    <Color x:Key="AccentLightColor">#9BC4C4</Color>
    <Color x:Key="AccentDarkColor">#4A6E6E</Color>
    <Color x:Key="DarkBackgroundColor">#0C0E12</Color>
    <Color x:Key="DarkSurfaceColor">#141820</Color>
    <Color x:Key="DarkCardColor">#1C2230</Color>
    <Color x:Key="DarkInputColor">#252B38</Color>
    <Color x:Key="TextPrimaryColor">#E8EAED</Color>
    <Color x:Key="TextSecondaryColor">#9BA3AD</Color>
    <Color x:Key="TextDisabledColor">#5A6270</Color>
    <Color x:Key="TextHintColor">#6B7280</Color>
    <Color x:Key="SelectionColor">#5B8A8A</Color>
    <Color x:Key="SelectionTextColor">#0C0E12</Color>
    <Color x:Key="ErrorColor">#B86B6B</Color>
    <Color x:Key="WarningColor">#C4A574</Color>
    <Color x:Key="SuccessColor">#6B9E78</Color>
    <Color x:Key="InfoColor">#5B8A8A</Color>
    <Color x:Key="AutonomyAccentColor">#8B7BA8</Color>
    <Color x:Key="BorderSubtleColor">#2A3140</Color>
    <Color x:Key="SurfaceHighlightColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="Primary50" Color="#E8EAED"/>
    <SolidColorBrush x:Key="Primary100" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Primary200" Color="#9BA3AD"/>
    <SolidColorBrush x:Key="Primary300" Color="#7AAFAF"/>
    <SolidColorBrush x:Key="Primary400" Color="#6B9494"/>
    <SolidColorBrush x:Key="Primary500" Color="#5B8A8A"/>
    <SolidColorBrush x:Key="Primary600" Color="#4A7272"/>
    <SolidColorBrush x:Key="Primary700" Color="#3D5C5C"/>
    <SolidColorBrush x:Key="Primary800" Color="#355050"/>
    <SolidColorBrush x:Key="Primary900" Color="#2A4040"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}"/>
    <SolidColorBrush x:Key="AccentA100" Color="#9BC4C4"/>
    <SolidColorBrush x:Key="AccentA200" Color="#7AAFAF"/>
    <SolidColorBrush x:Key="AccentA400" Color="#5B8A8A"/>
    <SolidColorBrush x:Key="AccentA700" Color="#4A7272"/>

    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackgroundColor}"/>
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurfaceColor}"/>
    <SolidColorBrush x:Key="DarkCardBrush" Color="{StaticResource DarkCardColor}"/>
    <SolidColorBrush x:Key="DarkInputBrush" Color="{StaticResource DarkInputColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextHintBrush" Color="{StaticResource TextHintColor}"/>

    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="{StaticResource SelectionTextColor}"/>

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="AutonomyAccentBrush" Color="{StaticResource AutonomyAccentColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>

    <DropShadowEffect x:Key="MaterialDesignShadowDepth1" Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="3" Opacity="0.15"/>
    <DropShadowEffect x:Key="MaterialDesignShadowDepth2" Color="#000000" Direction="270" ShadowDepth="3" BlurRadius="8" Opacity="0.18"/>
    <DropShadowEffect x:Key="MaterialDesignShadowDepth3" Color="#000000" Direction="270" ShadowDepth="5" BlurRadius="12" Opacity="0.22"/>
    <DropShadowEffect x:Key="MaterialDesignShadowDepth4" Color="#000000" Direction="270" ShadowDepth="8" BlurRadius="16" Opacity="0.25"/>
    <DropShadowEffect x:Key="MaterialDesignShadowDepth5" Color="#000000" Direction="270" ShadowDepth="12" BlurRadius="20" Opacity="0.28"/>
    <DropShadowEffect x:Key="MaterialDesignShadowDepth6" Color="#000000" Direction="270" ShadowDepth="16" BlurRadius="24" Opacity="0.32"/>

    <Style x:Key="MaterialDesignHeadline1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="96"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignHeadline2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="60"/>
        <Setter Property="FontWeight" Value="Light"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignHeadline3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="48"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignHeadline4" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignHeadline5" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignHeadline6" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignSubtitle1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignSubtitle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignBody1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignBody2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextHintBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignButton" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MaterialDesignOverline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="Foreground" Value="{StaticResource TextHintBrush}"/>
    </Style>

</ResourceDictionary>
