<Window x:Class="HouseVictoria.App.Screens.Windows.AddDataEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Data Entry" Height="480" Width="640"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterScreen">
    <Border Style="{StaticResource OverlayPanelShell}" Margin="12">
        <Border Style="{StaticResource GlassPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource OverlayPanelHeader}">
                    <TextBlock Text="Add Data Entry" Style="{StaticResource OverlayPanelTitle}"/>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="20,16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Title" Style="{StaticResource OverlayFieldLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TitleTextBox" Style="{StaticResource OverlayFieldInput}"/>

                        <TextBlock Text="Category" Style="{StaticResource OverlayFieldLabel}" Margin="0,12,0,6"/>
                        <TextBox x:Name="CategoryTextBox" Style="{StaticResource OverlayFieldInput}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                            <TextBlock Text="Importance" Style="{StaticResource OverlayFieldLabel}" VerticalAlignment="Center"/>
                            <Slider x:Name="ImportanceSlider" Minimum="0" Maximum="1" Value="0.5" Width="220" Margin="12,0"/>
                            <TextBlock Text="{Binding Value, ElementName=ImportanceSlider, StringFormat={}{0:F2}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Tags (comma separated)" Style="{StaticResource OverlayFieldLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TagsTextBox" Style="{StaticResource OverlayFieldInput}"/>

                        <TextBlock Text="Attachment (optional)" Style="{StaticResource OverlayFieldLabel}" Margin="0,12,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BrowseAttachmentButton" Content="Browse file"
                                    Style="{StaticResource GlassButton}" Width="120"
                                    Click="BrowseAttachmentButton_Click"/>
                            <Button x:Name="ClearAttachmentButton" Content="Remove"
                                    Style="{StaticResource GlassButton}" Width="90" Margin="8,0,0,0"
                                    Click="ClearAttachmentButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="AttachmentInfoText" Text="No file selected"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="Content" Style="{StaticResource OverlayFieldLabel}" Margin="0,0,0,6"/>
                        <TextBox x:Name="EntryTextBox" Style="{StaticResource OverlayFieldInput}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="180"
                                 FontFamily="Consolas"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource OverlayDialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GlassButton}" Content="Add" Width="100" Height="34" Margin="0,0,8,0"
                               Click="AddButton_Click"/>
                        <Button Style="{StaticResource OverlayCloseButton}" Content="Cancel" Width="100" Height="34"
                               Click="CancelButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
