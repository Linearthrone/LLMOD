<Window x:Class="HouseVictoria.App.Screens.Windows.SMSMMSWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="Messages" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IncomingToAlignmentConverter x:Key="IncomingToAlignmentConverter"/>
        <converters:MessageTypeVisibilityConverter x:Key="MessageTypeVisibilityConverter"/>
        <converters:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter"/>
        <converters:MessageToImageSourceConverter x:Key="MessageToImageSourceConverter"/>
        <converters:CallStateToTextConverter x:Key="CallStateToTextConverter"/>
        <converters:MessageSelectionConverter x:Key="MessageSelectionConverter"/>
    </Window.Resources>

    <!-- Resize Border - Invisible but allows resizing -->
    <Border x:Name="ResizeBorder" 
            Background="Transparent"
            BorderThickness="8"
            BorderBrush="Transparent">
        <!-- Obsidian Field phone frame -->
        <Border x:Name="PhoneFrame" 
                Background="{DynamicResource DarkCardBrush}"
                CornerRadius="32"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                Padding="6">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="4" Opacity="0.35"/>
            </Border.Effect>
            
            <!-- Inner Screen Container -->
            <Border Background="{DynamicResource DarkBackgroundBrush}" CornerRadius="26" ClipToBounds="True">
            <Grid>
                <Image x:Name="ChatSealBackground"
                       Stretch="Uniform"
                       Opacity="0.14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="24"
                       IsHitTestVisible="False"/>

            <!-- Top Notch/Punch Hole Area -->
        <Grid>
            <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Drag Area - Transparent top bar for dragging -->
                <Border Grid.Row="0" Background="Transparent" 
                        MouseLeftButtonDown="TopBar_MouseLeftButtonDown"
                        Cursor="SizeAll"/>

                <!-- Status bar notch -->
                <Border Grid.Row="0" Background="{DynamicResource DarkSurfaceBrush}" HorizontalAlignment="Center" 
                        Width="96" Height="22" CornerRadius="11" Margin="0,4,0,0"
                        IsHitTestVisible="False" Opacity="0.85">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource BorderSubtleBrush}" 
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Apps View -->
                <Grid Grid.Row="2" Visibility="{Binding ShowAppsView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Style="{StaticResource ChatScreenHeader}">
                        <StackPanel>
                            <TextBlock Text="Field Link" Style="{StaticResource ChatModuleTitle}"/>
                            <TextBlock Text="Companion surface" Style="{StaticResource ChatSubTitle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Apps Grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="8,12">
                        <UniformGrid Columns="2" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <!-- Messages App -->
                            <Button Command="{Binding OpenMessagesAppCommand}"
                                   Style="{StaticResource ChatAppLaunchTile}">
                                <StackPanel>
                                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                              Foreground="{DynamicResource PrimaryLightBrush}"
                                              HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Messages" 
                                              Foreground="{DynamicResource TextPrimaryBrush}" 
                                              FontSize="14" FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Phone App -->
                            <Button Command="{Binding OpenPhoneAppCommand}"
                                   Style="{StaticResource ChatAppLaunchTile}">
                                <StackPanel>
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                              Foreground="{DynamicResource PrimaryLightBrush}"
                                              HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="Voice" 
                                              Foreground="{DynamicResource TextPrimaryBrush}" 
                                              FontSize="14" FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </ScrollViewer>
                </Grid>

                <!-- Dialer View -->
                <Grid Grid.Row="2" Visibility="{Binding ShowDialerView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource DarkCardBrush}" Padding="16,12" Margin="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="←" FontSize="20" 
                                   Background="Transparent" BorderThickness="0" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0" Margin="0,0,12,0"
                                   Command="{Binding BackFromDialerCommand}"/>
                            <TextBlock Grid.Column="1" Text="Phone" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" 
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Contact Selection or Call View -->
                    <Grid Grid.Row="1">
                        <!-- Contact Selection -->
                        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                    Visibility="{Binding IsDialerContactSelected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <ItemsControl ItemsSource="{Binding Contacts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectDialerContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"
                                               Background="Transparent" 
                                               BorderThickness="0"
                                               Padding="16,12"
                                               Margin="0,0,0,1"
                                               HorizontalContentAlignment="Stretch"
                                               HorizontalAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="{DynamicResource DarkCardBrush}"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" 
                                                                       Padding="{TemplateBinding Padding}"
                                                                       Margin="{TemplateBinding Margin}">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource DarkInputBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Avatar -->
                                                <Ellipse Grid.Column="0" Width="50" Height="50" 
                                                        Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                                    <Ellipse.Clip>
                                                        <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                                                    </Ellipse.Clip>
                                                </Ellipse>
                                                
                                                <!-- Contact Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" 
                                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Type}" 
                                                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" 
                                                              Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Call View (when contact is selected) -->
                        <Grid Visibility="{Binding IsDialerContactSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                              VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Contact Avatar -->
                                <Ellipse Width="120" Height="120" 
                                        Fill="{DynamicResource PrimaryBrush}" 
                                        Margin="0,0,0,24"
                                        HorizontalAlignment="Center">
                                    <Ellipse.Clip>
                                        <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                                    </Ellipse.Clip>
                                </Ellipse>
                                
                                <!-- Contact Name -->
                                <TextBlock Text="{Binding SelectedDialerContact.Name}" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          FontSize="24" FontWeight="Bold"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,8"/>
                                
                                <!-- Call Status -->
                                <TextBlock Text="{Binding CurrentCallState, Converter={StaticResource CallStateToTextConverter}}" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" 
                                          FontSize="16"
                                          HorizontalAlignment="Center"
                                          Margin="0,0,0,40"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Phone Buttons -->
                    <Border Grid.Row="2" Background="{DynamicResource DarkCardBrush}" Padding="16,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Start Call Button (Green) -->
                            <Button Grid.Column="1" 
                                   Width="70" Height="70"
                                   Background="{DynamicResource SuccessBrush}" 
                                   BorderThickness="0"
                                   Command="{Binding StartDialerCallCommand}"
                                   ToolTip="Start Call"
                                   Visibility="{Binding CanStartDialerCall, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,0,20,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                           CornerRadius="35"
                                                           Width="70" Height="70">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                         VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#22C55E"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📞" 
                                          FontSize="32" 
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- End Call Button (Red) -->
                            <Button Grid.Column="2" 
                                   Width="70" Height="70"
                                   Background="{DynamicResource ErrorBrush}" 
                                   BorderThickness="0"
                                   Command="{Binding EndDialerCallCommand}"
                                   ToolTip="End Call"
                                   Visibility="{Binding CanEndDialerCall, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                           CornerRadius="35"
                                                           Width="70" Height="70">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                         VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#DC2626"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="📵" 
                                          FontSize="32" 
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Conversation List View -->
                <Grid Grid.Row="2" Visibility="{Binding ShowConversationList, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Style="{StaticResource ChatScreenHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Messages" Style="{StaticResource ChatModuleTitle}"/>
                                <TextBlock Text="Conversations" Style="{StaticResource ChatSubTitle}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource ChatSearchWell}" Margin="8,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Search threads…" Foreground="{DynamicResource TextHintBrush}" FontSize="13"/>
                            </Border>
                            <Button Grid.Column="2" Style="{StaticResource ChatIconActionButton}"
                                   Command="{Binding RefreshContactsCommand}"
                                   ToolTip="Refresh contacts">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource ChatPrimaryFab}"
                                   Command="{Binding StartNewConversationCommand}"
                                   ToolTip="New conversation">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Conversations List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Conversations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"
                                           Style="{StaticResource ChatListRowButton}"
                                           HorizontalAlignment="Stretch">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete conversation" 
                                                          Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <MenuItem Header="Archive to memory" 
                                                          Command="{Binding DataContext.ArchiveConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Avatar -->
                                            <Ellipse Grid.Column="0" Width="50" Height="50" 
                                                    Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                                <Ellipse.Clip>
                                                    <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                                                </Ellipse.Clip>
                                            </Ellipse>
                                            
                                            <!-- Contact Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" 
                                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding LastMessagePreview}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" 
                                                          Margin="0,2,0,0"/>
                                            </StackPanel>
                                            
                                            <!-- Time -->
                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding LastMessageAt, StringFormat='{}{0:HH:mm}'}" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" 
                                                      VerticalAlignment="Top" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Contact Selection View -->
                <Grid Grid.Row="2" Visibility="{Binding ShowContactSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
                    <Border Grid.Row="0" Background="{DynamicResource DarkCardBrush}" Padding="16,12" Margin="0,0,0,1">
                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="←" FontSize="20" 
                                   Background="Transparent" BorderThickness="0" 
                                   Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0" Margin="0,0,12,0"
                                   Command="{Binding BackToConversationListCommand}"/>
                            <TextBlock Grid.Column="1" Text="Select Contact" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" 
                                      VerticalAlignment="Center"/>
                </Grid>
            </Border>

                    <!-- Contacts List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Contacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"
                                           Background="Transparent" 
                                           BorderThickness="0"
                                           Padding="16,12"
                                           Margin="0,0,0,1"
                                           HorizontalContentAlignment="Stretch"
                                           HorizontalAlignment="Stretch">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource DarkCardBrush}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                   Padding="{TemplateBinding Padding}"
                                                                   Margin="{TemplateBinding Margin}">
                                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DarkInputBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Avatar -->
                                            <Ellipse Grid.Column="0" Width="50" Height="50" 
                                                    Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                                <Ellipse.Clip>
                                                    <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                                                </Ellipse.Clip>
                                            </Ellipse>
                                            
                                            <!-- Contact Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Type}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" 
                                                          Margin="0,2,0,0"/>
            </StackPanel>

                                            <!-- Type Indicator -->
                                            <TextBlock Grid.Column="2" 
                                                      Text="{Binding Type, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" 
                                                      VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value=""/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="AI">
                                                                <Setter Property="Text" Value="🤖"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Message View -->
                <Grid Grid.Row="2" Visibility="{Binding ShowMessageView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Message Header (normal mode) -->
                    <Border Grid.Row="0" Style="{StaticResource ChatScreenHeader}"
                            Visibility="{Binding IsMessageSelectionMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Back -->
                            <Button Grid.Column="0" Content="←" FontSize="20"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0" Margin="0,0,12,0"
                                    Command="{Binding BackToConversationListCommand}"/>

                            <!-- Avatar -> Contact profile overlay -->
                            <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="44"
                                    Height="44"
                                    Padding="0"
                                    Margin="0,0,12,0"
                                    Command="{Binding OpenContactProfileCommand}"
                                    ToolTip="Contact profile">
                                <Ellipse Width="44" Height="44" Fill="{DynamicResource PrimaryBrush}">
                                    <Ellipse.Clip>
                                        <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22"/>
                                    </Ellipse.Clip>
                                </Ellipse>
                            </Button>

                            <!-- Contact Name -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding SelectedConversationContactName}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>

                            <!-- Archive -->
                            <Button Grid.Column="3"
                                    Width="44" Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ArchiveConversationCommand}"
                                    ToolTip="Archive to AI memory">
                                <TextBlock Text="📦" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Select messages (delete mode) -->
                            <Button Grid.Column="4"
                                    Width="44" Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding EnterMessageSelectionModeCommand}"
                                    ToolTip="Delete messages">
                                <TextBlock Text="🗑" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Voice call -->
                            <Button Grid.Column="5"
                                    Width="44" Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding StartPhoneCallCommand}"
                                    ToolTip="Start voice call">
                                <TextBlock Text="📞" FontSize="20" Foreground="{DynamicResource SuccessBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Video call -->
                            <Button Grid.Column="6"
                                    Width="44" Height="44"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding StartCallCommand}"
                                    ToolTip="Video call (local preview; remote WebRTC not implemented)">
                                <TextBlock Text="🎥" FontSize="18" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Message Header (selection mode) -->
                    <Border Grid.Row="0" Style="{StaticResource ChatScreenHeader}"
                            Visibility="{Binding IsMessageSelectionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" FontSize="14"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" Padding="8,0" Margin="0,0,12,0"
                                    Command="{Binding ExitMessageSelectionModeCommand}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding SelectedMessageCount, StringFormat='{}{0} selected'}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="Delete" FontSize="14"
                                    Background="{DynamicResource ErrorBrush}" BorderThickness="0"
                                    Foreground="White" Padding="12,6" Margin="0,0,8,0"
                                    Command="{Binding DeleteSelectedMessagesCommand}"
                                    ToolTip="Delete selected messages"/>
                            <Button Grid.Column="3" Content="✕" FontSize="18"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextPrimaryBrush}" Padding="4,0"
                                    Command="{Binding ExitMessageSelectionModeCommand}"
                                    ToolTip="Cancel"/>
                        </Grid>
                    </Border>

                    <!-- Messages -->
                    <ScrollViewer x:Name="MessagesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                 Padding="12,8" Background="{DynamicResource DarkBackgroundBrush}" CanContentScroll="True">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Selection CheckBox (visible in selection mode) -->
                                        <CheckBox Grid.Column="0" Margin="8,0,8,0" VerticalAlignment="Center"
                                                  Command="{Binding DataContext.ToggleMessageSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding DataContext.IsMessageSelectionMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <CheckBox.IsChecked>
                                                <MultiBinding Converter="{StaticResource MessageSelectionConverter}" Mode="OneWay">
                                                    <Binding/>
                                                    <Binding Path="DataContext.SelectedMessageCount" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </CheckBox.IsChecked>
                                        </CheckBox>
                                        
                                        <!-- Incoming Message (clickable in selection mode to toggle) -->
                                        <Border Grid.Column="1"
                                               HorizontalAlignment="{Binding Direction, Converter={StaticResource IncomingToAlignmentConverter}}"
                                               MouseLeftButtonDown="MessageBorder_MouseLeftButtonDown"
                                               MaxWidth="280"
                                               Padding="12,8"
                                               CornerRadius="18"
                                               Margin="12,0,12,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource DarkSurfaceBrush}"/>
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="Margin" Value="12,0,60,0"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Direction}" Value="Outgoing">
                                                            <Setter Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="Margin" Value="60,0,12,0"/>
                                                </DataTrigger>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource MessageSelectionConverter}">
                                                            <Binding/>
                                                            <Binding Path="DataContext.SelectedMessageCount" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Image Preview -->
                                        <Border Background="#33000000" CornerRadius="8" 
                                               Margin="0,0,0,8" MaxWidth="250" MaxHeight="200"
                                               Visibility="{Binding Type, Converter={StaticResource MessageTypeVisibilityConverter}, ConverterParameter=Image}"
                                               Padding="4"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="MediaPreview_MouseLeftButtonDown"
                                               ToolTip="Click to open full size">
                                            <Image Source="{Binding Path=., Converter={StaticResource MessageToImageSourceConverter}}"
                                                  Stretch="Uniform" 
                                                  MaxWidth="250" MaxHeight="200"/>
                                        </Border>
                                        
                                        <!-- Video Preview Placeholder -->
                                        <Border Background="#33000000" CornerRadius="8" 
                                               Margin="0,0,0,8" MinWidth="250" MinHeight="150"
                                               Visibility="{Binding Type, Converter={StaticResource MessageTypeVisibilityConverter}, ConverterParameter=Video}"
                                               Padding="8"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="MediaPreview_MouseLeftButtonDown"
                                               ToolTip="Click to open video">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="🎥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                                <TextBlock Text="Video File" 
                                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                                          FontSize="14" 
                                                          HorizontalAlignment="Center"
                                                          TextWrapping="Wrap"
                                                          TextTrimming="CharacterEllipsis"
                                                          MaxWidth="200"/>
                                                <TextBlock Text="{Binding Content}" 
                                                          Foreground="#88FFFFFF" 
                                                          FontSize="12" 
                                                          HorizontalAlignment="Center"
                                                          Margin="0,4,0,0"
                                                          TextWrapping="Wrap"
                                                          TextTrimming="CharacterEllipsis"
                                                          MaxWidth="200"
                                                          Visibility="{Binding Content, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Audio/Document Indicator -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Audio">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Document">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="🎵"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="Document">
                                                                <Setter Property="Text" Value="📄"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" 
                                                      TextWrapping="Wrap" 
                                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                                      FontSize="14" VerticalAlignment="Center"
                                                      MouseLeftButtonDown="MediaPreview_MouseLeftButtonDown"
                                                      Cursor="Hand"
                                                      ToolTip="Click to open"/>
                                        </StackPanel>
                                        
                                        <!-- Text Content -->
                                        <TextBox Text="{Binding Content}" 
                                                 TextWrapping="Wrap" 
                                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 FontSize="15"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Padding="0"
                                                 VerticalContentAlignment="Top">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="CaretBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Image">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Video">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Audio">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Document">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" 
                                                  FontSize="10" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}" 
                                                  HorizontalAlignment="Right" 
                                                  Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                    </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                    <!-- Input Area -->
                    <Border Grid.Row="2" Style="{StaticResource ChatComposerBar}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Pending Attachment Info -->
                            <Border Grid.Row="0" Background="{DynamicResource DarkInputBrush}" CornerRadius="8" 
                                   Padding="12,8" Margin="0,0,0,8"
                                   Visibility="{Binding HasPendingMedia, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" 
                                              Text="{Binding PendingMediaDisplayInfo}"
                                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" 
                                              VerticalAlignment="Center"
                                              TextTrimming="CharacterEllipsis"/>
                                    
                                    <Button Grid.Column="1" Content="✕" FontSize="14" 
                                           Background="Transparent" BorderThickness="0" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Padding="6,2" 
                                           Width="24" Height="24" Margin="8,0,0,0"
                                           Command="{Binding ClearMediaCommand}"
                                           ToolTip="Remove Attachment">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        <Setter Property="Background" Value="{DynamicResource DarkSurfaceBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            
                            <!-- Input Controls -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Attachment Button -->
                                <Button Grid.Column="0" Content="📎" FontSize="20" 
                                       Background="Transparent" BorderThickness="0" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Padding="8" 
                                       Width="40" Height="40" Margin="0,0,4,0"
                                       VerticalAlignment="Bottom"
                                       Command="{Binding AttachMediaCommand}"
                                       ToolTip="Attach Media">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasPendingMedia}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter Property="Content" Value="📎✓"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Microphone Button -->
                                <Button Grid.Column="1" Content="🎤" FontSize="20" 
                                       Background="Transparent" BorderThickness="0" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Padding="8" 
                                       Width="40" Height="40" Margin="0,0,4,0"
                                       VerticalAlignment="Bottom"
                                       Command="{Binding ToggleAudioRecordingCommand}"
                                       IsEnabled="{Binding CanUseChatMicrophone}"
                                       ToolTip="{Binding AudioRecordingTooltip}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecordingAudio}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF3366"/>
                                                    <Setter Property="Content" Value="⏹️"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                
                                <!-- Input Box -->
                                <Border Grid.Column="2" Background="{DynamicResource DarkInputBrush}" CornerRadius="20" 
                                       Padding="16,10" Margin="4,0" VerticalAlignment="Bottom">
                                    <TextBox x:Name="MessageTextBox"
                                            Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" 
                                            Background="Transparent" BorderThickness="0" 
                                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" 
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            VerticalScrollBarVisibility="Auto"
                                            VerticalContentAlignment="Top"
                                            MinHeight="24"
                                            MaxHeight="132"
                                            KeyDown="MessageTextBox_KeyDown">
                                        <TextBox.CommandBindings>
                                            <CommandBinding Command="ApplicationCommands.Paste"
                                                            Executed="MessageTextBox_OnPaste"
                                                            CanExecute="MessageTextBox_OnPasteCanExecute"/>
                                        </TextBox.CommandBindings>
                                        <TextBox.InputBindings>
                                            <KeyBinding Gesture="Ctrl+V" Command="ApplicationCommands.Paste"/>
                                        </TextBox.InputBindings>
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Paste" Command="ApplicationCommands.Paste"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy" Command="ApplicationCommands.Copy"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Cut" Command="ApplicationCommands.Cut"
                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                </Border>

                                <!-- Send Button -->
                                <Button Grid.Column="3" Content="➤" FontSize="18" 
                                       Background="{DynamicResource PrimaryBrush}" BorderThickness="0" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Padding="12,8" 
                                       Width="40" Height="40" 
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Bottom"
                                       Command="{Binding SendMessageCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" 
                                                               CornerRadius="20"
                                                               Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" 
                                                                             VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource TextDisabledBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Contact Profile Overlay (in-place, no SMS navigation) -->
                    <Grid Grid.RowSpan="3"
                          Background="#66000000"
                          Visibility="{Binding ShowContactProfile, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{DynamicResource DarkCardBrush}"
                                CornerRadius="20"
                                Padding="16"
                                Width="340"
                                MaxHeight="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Profile Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="48" Height="48" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,12,0">
                                        <Ellipse.Clip>
                                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24"/>
                                        </Ellipse.Clip>
                                    </Ellipse>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedConversationContactName}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Column="2"
                                            Content="✕"
                                            Width="34" Height="34"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding CloseContactProfileCommand}"
                                            ToolTip="Close profile"/>
                                </Grid>

                                <!-- Profile Body -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Margin="0,12,0,0">
                                    <TextBlock Text="{Binding ContactProfileBody}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                
                <!-- Android Navigation Buttons -->
                <Border Grid.Row="4" Background="{DynamicResource DarkCardBrush}" Height="60" Padding="0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- TTS/STT Call buttons (visible in message/chat view only) -->
                        <Grid Grid.Column="1" Visibility="{Binding ShowMessageView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Start voice call (TTS/STT) -->
                            <!-- End voice call -->
                            <Button Width="50" Height="50"
                                   Background="Transparent" 
                                   BorderThickness="0"
                                   Command="{Binding EndCallCommand}"
                                   ToolTip="End voice call"
                                   Visibility="{Binding CanEndCall, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="📵" 
                                          FontSize="24" 
                                          Foreground="{DynamicResource ErrorBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                        
                        <!-- Back Button -->
                        <Button Grid.Column="2" 
                               Width="50" Height="50"
                               Background="Transparent" 
                               BorderThickness="0"
                               Click="BackButton_Click"
                               ToolTip="Back">
                            <TextBlock Text="◀" 
                                      FontSize="24" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Button>
                        
                        <!-- Home Button (Minimize to Tray) -->
                        <Button Grid.Column="3" 
                               Width="50" Height="50"
                               Background="Transparent" 
                               BorderThickness="0"
                               Margin="20,0"
                               Click="HomeButton_Click"
                               ToolTip="Home (Minimize to Tray)">
                            <Border Width="30" Height="30" 
                                   BorderBrush="{DynamicResource TextPrimaryBrush}" 
                                   BorderThickness="2"
                                   CornerRadius="4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <Border Background="{DynamicResource TextPrimaryBrush}" 
                                       CornerRadius="2"
                                       Margin="6,6,6,12"/>
                            </Border>
                        </Button>
                        
                        <!-- Recent Apps Button -->
                        <Button Grid.Column="4" 
                               Width="50" Height="50"
                               Background="Transparent" 
                               BorderThickness="0"
                               Click="RecentAppsButton_Click"
                               ToolTip="Recent Apps">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="20" Height="3" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <Rectangle Width="20" Height="3" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,3"/>
                                <Rectangle Width="20" Height="3" Fill="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            </Grid>
        </Border>
        </Border>
    </Border>
</Window>
