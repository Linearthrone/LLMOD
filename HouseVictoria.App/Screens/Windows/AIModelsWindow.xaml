<Window x:Class="HouseVictoria.App.Screens.Windows.AIModelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="AI Models &amp; Personas" Height="960" Width="1200" MinHeight="680" MinWidth="900"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/>
        <!-- Row text {DynamicResource TextPrimaryBrush}: hover/selection backgrounds must be darker for contrast -->
        <Style x:Key="OllamaModelsListViewItem" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#221C2230"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#331C2230"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="#441C2230"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="#331C2230"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource OverlayPanelHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="🤖 AI Models &amp; Personas" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="−" 
                               Width="30" Height="30" 
                               Style="{StaticResource OverlayMinimizeButton}" Background="#335B8A8A" 
                               BorderThickness="0"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand"
                               Margin="0,0,5,0"
                               Click="MinimizeButton_Click"
                               ToolTip="Minimize to Tray">
                        </Button>
                        <Button Content="✕" 
                               Width="30" Height="30" 
                               Style="{StaticResource OverlayCloseButton}" Background="#33B86B6B" 
                               BorderThickness="0"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand"
                               Click="CloseButton_Click"
                               ToolTip="Close">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,5">
                <Button Style="{StaticResource GlassButton}" Content="📁 Load Model" 
                       Margin="0,0,5,0" Command="{Binding LoadModelCommand}"/>
                <Button Style="{StaticResource GlassButton}" Content="👤 Create Persona" 
                       Margin="5,0,5,0" Command="{Binding CreatePersonaCommand}"/>
                <Button Style="{StaticResource GlassButton}" Content="📖 AI Contact Book" 
                       Margin="5,0,5,0" Command="{Binding ShowContactBookCommand}"/>
                <Button Style="{StaticResource GlassButton}" Content="🎨 Image Generation" 
                       Margin="5,0" Command="{Binding ShowImageGenerationCommand}"/>
            </StackPanel>

            <!-- Content Area -->
            <Border Grid.Row="2" Padding="10" ClipToBounds="True">
                <Grid>
                    <!-- Load Model View -->
                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=LoadModel}">
                        <Border Style="{StaticResource Card}" Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="📥 Ollama model control and availability" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
                                
                                <!-- Ollama Run Section -->
                                <Border Style="{StaticResource OverlayPanelToolbar}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="🚀 Download New Model" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Model Name:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding OllamaRunCommand, UpdateSourceTrigger=PropertyChanged}" 
                                                    Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                    Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"
                                                    IsEnabled="{Binding IsPullingModel, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <TextBox.ToolTip>
                                                    <TextBlock>
                                                        Enter the model name to download from Ollama<LineBreak/>
                                                        Examples: "llama3.1", "mistral:latest"
                                                    </TextBlock>
                                                </TextBox.ToolTip>
                                            </TextBox>
                                            <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="⬇️ Download" 
                                                   Margin="5,0,0,0" Command="{Binding RunOllamaCommand}"
                                                   IsEnabled="{Binding IsRunningOllamaCommand, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                            <Button Grid.Column="3" Style="{StaticResource GlassButton}" Content="✕ Cancel" 
                                                   Margin="5,0,0,0" Command="{Binding CancelOllamaCommand}"
                                                   IsEnabled="{Binding IsRunningOllamaCommand}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding PullModelStatus}" 
                                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0"
                                                  TextWrapping="Wrap"
                                                  Visibility="{Binding PullModelStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="MaxHeight" Value="60"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="MaxHeight" Value="300"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Background="#111827" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,0">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,8">
                                                    <TextBlock Text="Command Output" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"/>
                                                    <TextBlock Text="Running..." 
                                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right"
                                                               Visibility="{Binding IsRunningOllamaCommand, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </DockPanel>
                                                <TextBox x:Name="LoadModelLogTextBox"
                                                         Text="{Binding LoadModelLog}"
                                                         Background="#0B1220"
                                                         BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontFamily="Consolas"
                                                         FontSize="12"
                                                         Padding="8"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         IsReadOnly="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Height="170"
                                                         TextChanged="LoadModelLogTextBox_TextChanged"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                
                                <Separator Margin="0,0,0,15" Background="#1A2332"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ollama Endpoint:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1A2332" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Margin="5,0" Padding="8">
                                        <TextBlock Text="{Binding OllamaEndpoint}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="🔍 Show Available Models" 
                                           Margin="5,0,0,0" Command="{Binding LoadAvailableModelsCommand}"/>
                                </Grid>
                                <TextBlock Text="Available Models:" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,15,0,5"/>
                                <ListView ItemsSource="{Binding AvailableOllamaModels}"
                                          SelectedItem="{Binding SelectedOllamaModel}"
                                          ItemContainerStyle="{StaticResource OllamaModelsListViewItem}"
                                          Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" Height="200" Margin="0,5">
                                    <ListView.Resources>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="Background" Value="#1A3045"/>
                                            <Setter Property="Foreground" Value="#B8E8F5"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="#4000D4FF"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#153850"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.Resources>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Model" Width="280" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                            <GridViewColumn Header="Downloaded" Width="140" DisplayMemberBinding="{Binding DownloadedAtDisplay}"/>
                                            <GridViewColumn Header="Last used" Width="140" DisplayMemberBinding="{Binding LastUsedAtDisplay}"/>
                                            <GridViewColumn Header="Personas" Width="80" DisplayMemberBinding="{Binding PersonasUsingCount}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <TextBlock Text="{Binding SelectedModel, StringFormat='Selected: {0}'}" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Create Persona View (Grid fills content area so ScrollViewer gets a bounded height) -->
                    <Grid Visibility="{Binding CurrentView, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=CreatePersona}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,5,0,8">
                            <Border Style="{StaticResource Card}" Margin="0,5">
                                <StackPanel>
                                <TextBlock Text="{Binding PersonaFormTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>

                                <!-- Live preview card -->
                                <Border Background="#1A5B8A8A" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#2A3A4A" Margin="0,0,12,0" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding PreviewInitial}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasPreviewPortrait, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                <Image Source="{Binding PreviewPortrait}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasPreviewPortrait, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PreviewName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PreviewRoleLabel}" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="Model: "/><Run Text="{Binding NewPersonaModel}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewPersonaName, UpdateSourceTrigger=PropertyChanged}" 
                                            Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                            Foreground="White" Padding="8" Margin="5,0"/>
                                </Grid>
                                <!-- Inline name validation -->
                                <TextBlock Text="{Binding NameValidationMessage}" Foreground="#FF8A80" FontSize="11"
                                           Margin="155,2,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding HasNameValidationMessage, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Role selector -->
                                <Grid Margin="0,8,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Role:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0">
                                        <RadioButton Content="Primary (always active)" GroupName="PersonaRole"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsRolePrimary, Mode=TwoWay}"
                                                     ToolTip="The house brain used by autonomy, journals and the remote companion. Only one persona is primary."/>
                                        <RadioButton Content="Companion" GroupName="PersonaRole"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsRoleCompanion, Mode=TwoWay}"/>
                                        <RadioButton Content="None" GroupName="PersonaRole"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                     IsChecked="{Binding IsRoleNone, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Starter template / preset -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Starter template:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePersonaPresets}"
                                              SelectedItem="{Binding SelectedPersonaPreset, Mode=TwoWay}"
                                              Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="White" Padding="8" Margin="5,0"
                                              ToolTip="Seeds the system prompt and sampling parameters. Choose Custom to keep your own values.">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#252F3F"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" 
                                            x:Name="ModelComboBox"
                                            ItemsSource="{Binding AvailableModels}" 
                                            Text="{Binding NewPersonaModel, UpdateSourceTrigger=PropertyChanged}"
                                            SelectionChanged="ModelComboBox_SelectionChanged"
                                            Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                            Foreground="White" Padding="8" Margin="5,0"
                                            IsEditable="True"
                                            IsEnabled="{Binding IsPullingModel, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#252F3F"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4000D4FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ToolTip>
                                            <TextBlock>
                                                Select a model from the dropdown or type a model name.<LineBreak/>
                                                Models can be downloaded from the "Load Model" tab.
                                            </TextBlock>
                                        </ComboBox.ToolTip>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="{Binding PullModelStatus}" 
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,5,0,0"
                                          TextWrapping="Wrap"
                                          Visibility="{Binding PullModelStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="MaxHeight" Value="60"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="MaxHeight" Value="300"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Advanced: MCP endpoint (auto-generated; override only if needed) -->
                                <Expander Margin="0,5" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="🔌 Advanced (MCP endpoint)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Expander.Header>
                                    <Border Style="{StaticResource OverlayPanelToolbar}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="MCP Server:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding NewPersonaMCPServer, UpdateSourceTrigger=PropertyChanged}" 
                                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                        Foreground="White" Padding="8" Margin="5,0"/>
                                            </Grid>
                                            <TextBlock Text="Per-persona MCP endpoint. Leave as-is unless you run a dedicated server for this persona." 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
<TextBlock Grid.Column="0" Text="TTS Voice:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePiperVoices}"
                                            Text="{Binding NewPersonaPiperVoice, UpdateSourceTrigger=PropertyChanged}"
                                            IsEditable="True"
                                            Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                            Foreground="White" Padding="8" Margin="5,0">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#252F3F"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4000D4FF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ToolTip>
                                            <TextBlock>Voice used during streaming voice calls (Kokoro, built into the on-device engine).</TextBlock>
                                        </ComboBox.ToolTip>
                                    </ComboBox>
                                </Grid>
                                <!-- Portrait image (shown in chat / contact book) -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Portrait:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewPersonaAvatarUrl, UpdateSourceTrigger=PropertyChanged}"
                                            Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            Foreground="White" Padding="8" Margin="5,0"/>
                                    <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="Browse…"
                                            Margin="5,0,0,0" Command="{Binding BrowsePortraitCommand}"/>
                                </Grid>

                                <!-- Avatar Settings (virtual environment) -->
                                <Expander Margin="0,10,0,5" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="👤 Avatar Settings (Virtual Environment)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Expander.Header>
                                    <Border Style="{StaticResource OverlayPanelToolbar}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                                        <StackPanel>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="3D Model Path:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding NewPersonaAvatarModelPath, UpdateSourceTrigger=PropertyChanged}" 
                                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                            </Grid>
                                            <TextBlock Text="Path to avatar 3D model (.fbx, .glb) for the virtual environment" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Voice Speed:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0.1" Maximum="3.0" Value="{Binding NewPersonaAvatarVoiceSpeed, UpdateSourceTrigger=PropertyChanged}" 
                                                       TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="5,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NewPersonaAvatarVoiceSpeed, StringFormat='{}{0:F1}'}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Voice Pitch:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0.1" Maximum="3.0" Value="{Binding NewPersonaAvatarVoicePitch, UpdateSourceTrigger=PropertyChanged}" 
                                                       TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="5,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NewPersonaAvatarVoicePitch, StringFormat='{}{0:F1}'}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Description:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewPersonaDescription, UpdateSourceTrigger=PropertyChanged}" 
                                            Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                            Foreground="White" Padding="8" Margin="5,0" TextWrapping="Wrap" Height="60"/>
                                </Grid>
                                <Expander Margin="0,10,0,5" IsExpanded="True">
                                    <Expander.Header>
                                        <TextBlock Text="🔒 Shared knowledge (what this persona may see in chat)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Expander.Header>
                                    <Border Style="{StaticResource OverlayPanelToolbar}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,5">
                                        <StackPanel>
                                            <TextBlock Text="Companions only see basics about you plus their own memories by default. Check boxes to share more."
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <CheckBox Content="About me — global facts about the human user"
                                                      IsChecked="{Binding ShareUserBasics, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                            <CheckBox Content="This persona's own chat memories"
                                                      IsChecked="{Binding ShareOwnMemories, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                            <CheckBox Content="This persona's data bank"
                                                      IsChecked="{Binding ShareOwnDataBank, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                            <CheckBox Content="House journals &amp; research (Victoria / autonomy work)"
                                                      IsChecked="{Binding ShareHouseJournals, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                            <CheckBox Content="Other personas' memories"
                                                      IsChecked="{Binding ShareOtherPersonaMemories, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                            <CheckBox Content="Shared / global data banks"
                                                      IsChecked="{Binding ShareSharedDataBanks, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="System Prompt:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <Border Grid.Column="1" Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Margin="5,0">
                                        <TextBox Text="{Binding NewPersonaSystemPrompt, UpdateSourceTrigger=PropertyChanged}" 
                                                Background="Transparent" BorderThickness="0" 
                                                Foreground="White" Padding="8" 
                                                TextWrapping="Wrap" AcceptsReturn="True" 
                                                VerticalScrollBarVisibility="Auto"
                                                VerticalContentAlignment="Top" 
                                                MinHeight="100" MaxHeight="200"/>
                                    </Border>
                                </Grid>
                                
                                <!-- LLM Parameters Section -->
                                <Expander Margin="0,10,0,5" IsExpanded="False">
                                    <Expander.Header>
                                        <TextBlock Text="⚙️ LLM Parameters (Advanced)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                    </Expander.Header>
                                    <Border Style="{StaticResource OverlayPanelToolbar}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,5">
                                        <StackPanel>
                                            <!-- Temperature -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Temperature:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding NewPersonaTemperature, UpdateSourceTrigger=PropertyChanged}" 
                                                       TickFrequency="0.1" IsSnapToTickEnabled="False" Margin="5,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NewPersonaTemperature, StringFormat='{}{0:F2}'}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="Controls randomness (0.0 = focused, 2.0 = creative)" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                            
                                            <!-- Top P -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Top P:" Foreground="White" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding NewPersonaTopP, UpdateSourceTrigger=PropertyChanged}" 
                                                       TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="5,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NewPersonaTopP, StringFormat='{}{0:F2}'}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="Nucleus sampling - controls diversity via probability" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                            
                                            <!-- Top K -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Top K:" Foreground="White" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding NewPersonaTopK, UpdateSourceTrigger=PropertyChanged}" 
                                                       TickFrequency="1" IsSnapToTickEnabled="True" Margin="5,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NewPersonaTopK}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="Limits sampling to top K most likely tokens" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                            
                                            <!-- Repeat Penalty -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Repeat Penalty:" Foreground="White" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding NewPersonaRepeatPenalty, UpdateSourceTrigger=PropertyChanged}" 
                                                       TickFrequency="0.1" IsSnapToTickEnabled="False" Margin="5,0"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding NewPersonaRepeatPenalty, StringFormat='{}{0:F2}'}" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="Penalizes repetition (higher = less repetition)" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                            
                                            <!-- Max Tokens -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Max Tokens:" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding NewPersonaMaxTokens, UpdateSourceTrigger=PropertyChanged}" 
                                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                            </Grid>
                                            <TextBlock Text="Maximum tokens to generate (-1 = unlimited)" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                            
                                            <!-- Context Length -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Context Length:" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" Text="{Binding NewPersonaContextLength, UpdateSourceTrigger=PropertyChanged}" 
                                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                            </Grid>
                                            <TextBlock Text="Size of the context window (varies by model)" 
                                                      FontSize="10" Foreground="#5A6A7A" Margin="155,0,0,5"/>
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                        </ScrollViewer>

                        <!-- Sticky footer: always visible without scrolling -->
                        <Border Grid.Row="1" Background="#200A0E27" BorderBrush="#3000D4FF" BorderThickness="0,1,0,0" Padding="10,8,10,4" Margin="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Cancel"
                                        Command="{Binding CancelEditPersonaCommand}"
                                        Visibility="{Binding IsEditingPersona, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}"/>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="2"
                                        Content="{Binding SavePersonaButtonText}"
                                        Width="200"
                                        Command="{Binding SavePersonaCommand}"
                                        ToolTip="Save persona settings including model, prompt, and LLM parameters">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="ToolTip" Value="Please enter a name and select/type a model name"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- AI Contact Book View -->
                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=ContactBook}">
                        <Border Style="{StaticResource Card}" Margin="0,5">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📖 AI Contact Book" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="📥 Restore Backup"
                                            Command="{Binding RestorePersonaCommand}"
                                            ToolTip="Import a persona backup (.zip) from another machine or model"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AIContacts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,5" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <Border Background="#335B8A8A" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="3"
                                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsPrimaryAI, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="PRIMARY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                        <TextBlock FontSize="11" Foreground="#5A6A7A" Margin="0,2,0,0">
                                                            <Run Text="Model: "/>
                                                            <Run Text="{Binding ModelName}"/>
                                                            <Run Text=" | "/>
                                                            <Run Text="{Binding IsLoaded, StringFormat='Loaded: {0}'}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GlassButton}" Content="⭐ Set Primary"
                                                               Margin="5,0" Command="{Binding DataContext.SetPrimaryPersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Make this the always-active primary persona"
                                                               Visibility="{Binding IsPrimaryAI, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                        <Button Style="{StaticResource GlassButton}" Content="📂 Load" 
                                                               Margin="5,0" Command="{Binding DataContext.LoadPersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource GlassButton}" Content="💾 Backup"
                                                               Margin="5,0" Command="{Binding DataContext.BackupPersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"
                                                               ToolTip="Export memories, databanks, chat history, and media"/>
                                                        <Button Style="{StaticResource GlassButton}" Content="✏️ Edit" 
                                                               Margin="5,0" Command="{Binding DataContext.EditPersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource GlassButton}" Content="🗑️" 
                                                               Margin="5,0" Command="{Binding DataContext.DeletePersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No AI contacts found. Create a new persona to get started." 
                                          FontSize="12" Foreground="#5A6A7A" 
                                          HorizontalAlignment="Center" Margin="0,20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AIContacts.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Image Generation View -->
                    <StackPanel Visibility="{Binding CurrentView, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=ImageGeneration}">
                        <Border Style="{StaticResource Card}" Margin="0,5">
                            <StackPanel>
                                <TextBlock Text="🎨 AI Image Generation" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>
                                
                                <!-- Image Generation Prompt -->
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Prompt:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding ImageGenerationPrompt, UpdateSourceTrigger=PropertyChanged}" 
                                            Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                            Foreground="White" Padding="8" Margin="5,0" 
                                            TextWrapping="Wrap" Height="100" AcceptsReturn="True"/>
                                </Grid>

                                <!-- Generation Options -->
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Width:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="256" Maximum="1024" Value="{Binding ImageWidth}" 
                                           TickFrequency="128" IsSnapToTickEnabled="True" Margin="5,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ImageWidth, StringFormat='{}Width: {0}px'}" 
                                              Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="5,25,0,0"/>
                                </Grid>

                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Height:" Foreground="White" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="256" Maximum="1024" Value="{Binding ImageHeight}" 
                                           TickFrequency="128" IsSnapToTickEnabled="True" Margin="5,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ImageHeight, StringFormat='{}Height: {0}px'}" 
                                              Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="5,25,0,0"/>
                                </Grid>

                                <!-- Generate Button -->
                                <Button Content="🎨 Generate Image" 
                                       Margin="0,15,0,5" HorizontalAlignment="Right" Width="200"
                                       Command="{Binding GenerateImageCommand}"
                                       IsEnabled="{Binding IsGeneratingImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                            <Style.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                    <Setter Property="ToolTip" Value="Please enter a prompt to generate an image"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- Status and Preview -->
                                <TextBlock Text="{Binding ImageGenerationStatus}" 
                                          Foreground="#CCCCCC" FontSize="12" Margin="0,10,0,0"
                                          TextWrapping="Wrap"
                                          Visibility="{Binding HasImageGenerationStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="MaxHeight" Value="60"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="MaxHeight" Value="300"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Generated Image Preview -->
                                <Border Style="{StaticResource OverlayPanelToolbar}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" 
                                       CornerRadius="5" Padding="10" Margin="0,10,0,0"
                                       Visibility="{Binding HasGeneratedImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Generated Image:" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                        <Image Source="{Binding GeneratedImagePath}" 
                                              MaxWidth="512" MaxHeight="512" 
                                              Stretch="Uniform" 
                                              HorizontalAlignment="Center"/>
                                        <Button Content="💾 Save Image" 
                                               Style="{StaticResource GlassButton}" 
                                               Margin="0,10,0,0" Width="150"
                                               Command="{Binding SaveGeneratedImageCommand}"
                                               HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

</Window>
