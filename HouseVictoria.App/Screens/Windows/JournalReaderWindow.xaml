<Window x:Class="HouseVictoria.App.Screens.Windows.JournalReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="Journal" Height="900" Width="800"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource OverlayWindow}"
        Background="Transparent">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Style="{StaticResource OverlayPanelShell}" Margin="16">
        <Border Style="{StaticResource GlassPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource OverlayPanelHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Conclude" Command="{Binding ConcludeCommand}"
                                    Visibility="{Binding CanConclude, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource GlassButton}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="✕" Style="{StaticResource OverlayCloseButton}" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16">
                    <Border CornerRadius="8" Padding="32,28"
                            Background="#FF1A1814"
                            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Preface" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Why I chose to pursue this" FontSize="11"
                                       Foreground="{DynamicResource TextHintBrush}" FontStyle="Italic" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding Preface}" FontSize="15"
                                       Foreground="#D4C8B8" TextWrapping="Wrap" LineHeight="24"
                                       Margin="0,0,0,32"/>

                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,28" Opacity="0.6"/>

                            <ItemsControl ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,28">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding DateLabel}" FontSize="11"
                                                           Foreground="{DynamicResource TextHintBrush}" FontStyle="Italic"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="17"
                                                       FontWeight="SemiBold" Foreground="#E8E0D4" TextWrapping="Wrap"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock Text="{Binding Body}" FontSize="14"
                                                       Foreground="#D4C8B8" TextWrapping="Wrap" LineHeight="22"/>

                                            <StackPanel Margin="0,14,0,0"
                                                        Visibility="{Binding HasReferences, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="External sources" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding References}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayLine}" FontSize="12"
                                                                       Foreground="#B8A898" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,20,0,0" Opacity="0.4"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding HasGeneratedFiles, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,8,0,28">
                                <Border Height="1" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,16" Opacity="0.35"/>
                                <TextBlock Text="Generated Research Files" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="All files produced during this journal thread" FontSize="11"
                                           Foreground="{DynamicResource TextHintBrush}" FontStyle="Italic" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding GeneratedFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <Button HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" FontSize="13" Foreground="{DynamicResource PrimaryLightBrush}"
                                                        Padding="0,2"
                                                        Command="{Binding DataContext.OpenLinkedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding FilePath}">
                                                    <TextBlock Text="{Binding DisplayName}" TextDecorations="Underline"/>
                                                </Button>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                           Foreground="{DynamicResource TextHintBrush}" FontStyle="Italic"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasConclusion, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,12,0,0">
                                <Border Height="1" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,20" Opacity="0.35"/>
                                <TextBlock Text="Conclusion" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Summary of findings" FontSize="11"
                                           Foreground="{DynamicResource TextHintBrush}" FontStyle="Italic" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ConclusionSummary}" FontSize="14"
                                           Foreground="#D4C8B8" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,20"/>
                                <TextBlock Text="Implications" FontSize="11"
                                           Foreground="{DynamicResource TextHintBrush}" FontStyle="Italic" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ConclusionImplications}" FontSize="14"
                                           Foreground="#D4C8B8" TextWrapping="Wrap" LineHeight="22"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>
