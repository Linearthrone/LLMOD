<Window x:Class="HouseVictoria.App.Screens.Windows.CreateDataBankDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="Create Data Bank" Height="380" Width="720" MinHeight="360" MinWidth="640"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Border Style="{StaticResource OverlayPanelShell}" Margin="12">
        <Border Style="{StaticResource GlassPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource OverlayPanelHeader}">
                    <TextBlock Text="Create Data Bank" Style="{StaticResource OverlayPanelTitle}"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="20,16">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource OverlayFieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource OverlayFieldInput}" Margin="10,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Description" Style="{StaticResource OverlayFieldLabel}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource OverlayFieldInput}" Margin="10,0,0,0"
                                TextWrapping="Wrap" AcceptsReturn="True" Height="120"
                                VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                    <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                               TextWrapping="Wrap" Visibility="{Binding ValidationError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource OverlayDialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GlassButton}" Content="Save" Width="100" Height="34" Margin="0,0,8,0"
                               Click="SaveButton_Click"/>
                        <Button Style="{StaticResource OverlayCloseButton}" Content="Cancel" Width="100" Height="34"
                               Click="CancelButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
