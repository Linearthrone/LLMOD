<Window x:Class="HouseVictoria.App.Screens.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="Settings" Height="900" Width="1280"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:SettingsCategoryVisibilityConverter x:Key="SettingsCategoryVisibilityConverter"/>
        <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource OverlayPanelHeader}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#181E28"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Margin="0,0,12,0">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource PrimaryLightBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Field Configuration"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Obsidian overlay control surface"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="−" 
                               Width="30" Height="30" 
                               Style="{StaticResource OverlayMinimizeButton}" Background="#335B8A8A" 
                               BorderThickness="0"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand"
                               Margin="0,0,5,0"
                               Click="MinimizeButton_Click"
                               ToolTip="Minimize to Tray"/>
                        <Button Content="✕" 
                               Width="30" Height="30" 
                               Style="{StaticResource OverlayCloseButton}" Background="#33B86B6B" 
                               BorderThickness="0"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand"
                               Click="CloseButton_Click"
                               ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Master-detail body -->
            <Grid Grid.Row="1" Margin="12,8,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#CC10141A"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10"
                        Margin="0,0,10,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="MODULES"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="4,2,0,10"/>
                        <ListBox ItemsSource="{Binding SettingsNavItems}"
                                 SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                                 Style="{StaticResource SettingsNavList}"
                                 ItemContainerStyle="{StaticResource SettingsNavItem}"/>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="#CC10141A"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="18,14"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedNavItem.Title, FallbackValue=Settings}"
                                           Style="{StaticResource SettingsHeroTitle}"/>
                                <TextBlock Text="{Binding SelectedNavItem.Subtitle, FallbackValue=Select a module on the left.}"
                                           Style="{StaticResource SettingsHeroSubtitle}"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,12">
                            <StackPanel>
                    <!-- SMS/MMS Settings -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=connect}">
                        <StackPanel>
                            <TextBlock Text="📱 SMS/MMS Communication" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock Text="Configure SMS and MMS settings" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- MCP Server Settings -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=intelligence}">
                        <StackPanel>
                            <TextBlock Text="🔌 MCP Server" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding MCPServerEndpoint, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding MCPServerConnectionStatus}" 
                                          VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"
                                          Visibility="{Binding MCPServerConnectionStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MCPServerConnectionStatus}" Value="✗ Failed">
                                                    <Setter Property="Foreground" Value="#FF3366"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MCPServerConnectionStatus}" Value="Testing...">
                                                    <Setter Property="Foreground" Value="#FFAA00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="Test" Style="{StaticResource GlassButton}" 
                                       Command="{Binding TestMCPConnectionCommand}" 
                                       Width="80" Margin="5,0" IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- TTS / STT Settings -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=connect}">
                        <StackPanel>
                            <TextBlock Text="🎙 Speech-to-Text" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock Text="Used for chat dictation and the remote companion app. Voice calls use the built-in streaming engine (no STT server needed)."
                                      FontSize="11" Foreground="#5A6A7A" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="STT Endpoint:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding STTEndpoint, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding STTConnectionStatus}" 
                                          Foreground="#00FF88" 
                                          VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"
                                          Visibility="{Binding STTConnectionStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding STTConnectionStatus}" Value="✗ Failed">
                                                    <Setter Property="Foreground" Value="#FF3366"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding STTConnectionStatus}" Value="Testing...">
                                                    <Setter Property="Foreground" Value="#FFAA00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="Test" Style="{StaticResource GlassButton}" 
                                       Command="{Binding TestSTTConnectionCommand}" 
                                       Width="80" Margin="5,0" IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Image Generation Endpoint (ComfyUI) -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=creativity}">
                        <StackPanel>
                            <TextBlock Text="🎨 Image Generation" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock Text="Select a provider, then configure credentials and endpoints in the panel below." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Provider:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ImageGenerationProviderOptions}"
                                          SelectedItem="{Binding ImageGenerationProvider, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource SettingsProviderPicker}"
                                          Margin="5,0"/>
                            </Grid>
                            <Border Background="#121820"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,10,0,0"
                                    MinHeight="180">
                                <StackPanel>
                            <StackPanel Visibility="{Binding ImageGenerationProvider, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=a2e}">
                            <TextBlock Text="A2E Cloud" Style="{StaticResource SettingsSectionTitle}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="A2E API token:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding A2eApiToken, UpdateSourceTrigger=PropertyChanged}"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                            </Grid>
                            <TextBlock Text="Bearer token from video.a2e.ai → API Token. Or set env A2E_API_TOKEN. Restart app after saving."
                                      FontSize="11" Foreground="#5A6A7A" Margin="0,3,0,8" FontStyle="Italic" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="A2E API URL:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding A2eApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                            </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ImageGenerationProvider, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=comfyui}">
                            <TextBlock Text="Local ComfyUI" Style="{StaticResource SettingsSectionTitle}"/>
                            <TextBlock Text="Configure the local image endpoint (typically ComfyUI on port 8188)." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding StableDiffusionEndpoint, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding StableDiffusionConnectionStatus}" 
                                          VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"
                                          Visibility="{Binding StableDiffusionConnectionStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StableDiffusionConnectionStatus}" Value="✗ Failed">
                                                    <Setter Property="Foreground" Value="#FF3366"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StableDiffusionConnectionStatus}" Value="Testing...">
                                                    <Setter Property="Foreground" Value="#FFAA00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="Test" Style="{StaticResource GlassButton}" 
                                       Command="{Binding TestStableDiffusionConnectionCommand}" 
                                       Width="80" Margin="5,0" IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                            <TextBlock Text="Default: http://localhost:8188 (ComfyUI)" 
                                      FontSize="11" Foreground="#5A6A7A" Margin="0,5,0,0" FontStyle="Italic"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Checkpoint:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableComfyUICheckpoints}"
                                          Text="{Binding ComfyUIPreferredCheckpoint, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Background="{DynamicResource DarkInputBrush}"
                                          BorderBrush="{DynamicResource BorderSubtleBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Padding="8"
                                          Margin="5,0"/>
                                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource GlassButton}"
                                       Command="{Binding RefreshComfyUICheckpointsCommand}" Width="80" Margin="5,0"/>
                            </Grid>
                            <TextBlock Text="Preferred checkpoint for built-in ComfyUI image generation. Use SDXL/photoreal checkpoints for more realism; leave exact filename from ComfyUI."
                                      FontSize="11" Foreground="#5A6A7A" Margin="0,3,0,0" FontStyle="Italic" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Custom workflow:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding ComfyUICustomWorkflowPath, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                <Button Grid.Column="2" Content="Browse" Style="{StaticResource GlassButton}" 
                                       Command="{Binding BrowseComfyUICustomWorkflowPathCommand}" Width="70" Margin="5,0"/>
                            </Grid>
                            <TextBlock Text="Optional: Path to custom workflow JSON (ComfyUI API format). Use placeholders {{positive}}, {{negative}}, {{width}}, {{height}}, {{seed}}, {{filename_prefix}}."
                                      FontSize="11" Foreground="#5A6A7A" Margin="0,3,0,0" FontStyle="Italic" TextWrapping="Wrap"/>
                            </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Stability Matrix & ComfyUI (image/video generation) -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=creativity}">
                        <StackPanel>
                            <TextBlock Text="🖼️ Stability Matrix &amp; ComfyUI" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock Text="Start Stability Matrix and ComfyUI portable for image and video generation. Set the endpoint above to http://localhost:8188 when using ComfyUI." FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid Margin="0,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Stability Matrix:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StabilityMatrixPath, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                <Button Grid.Row="0" Grid.Column="2" Content="Browse" Style="{StaticResource GlassButton}" 
                                       Command="{Binding BrowseStabilityMatrixPathCommand}" Width="70" Margin="5,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ComfyUI folder:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ComfyUIPortablePath, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,8,5,0"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse" Style="{StaticResource GlassButton}" 
                                       Command="{Binding BrowseComfyUIPortablePathCommand}" Width="70" Margin="5,8,5,0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Start Stability Matrix" Style="{StaticResource GlassButton}" 
                                       Command="{Binding StartStabilityMatrixCommand}" Margin="0,0,10,0"/>
                                <Button Content="Start ComfyUI" Style="{StaticResource GlassButton}" 
                                       Command="{Binding StartComfyUICommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Virtual Environment Settings -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=presence}">
                        <StackPanel>
                            <TextBlock Text="🌐 Virtual Environment (Unreal Engine)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Endpoint:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding UnrealEngineEndpoint, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" 
                                        Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding UnrealConnectionStatus}" 
                                          Foreground="#00FF88" 
                                          VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"
                                          Visibility="{Binding UnrealConnectionStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnrealConnectionStatus}" Value="✗ Failed">
                                                    <Setter Property="Foreground" Value="#FF3366"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding UnrealConnectionStatus}" Value="Testing...">
                                                    <Setter Property="Foreground" Value="#FFAA00"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="3" Content="Test" Style="{StaticResource GlassButton}" 
                                       Command="{Binding TestUnrealConnectionCommand}" 
                                       Width="80" Margin="5,0" IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                            <TextBlock Text="Configure avatar locomotion, physical interactions, and virtual world settings" 
                                      FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Remote companion: phone → PC (text + audio); TLS at edge (tunnel). Restart app after changing. -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=connect}">
                        <StackPanel>
                            <TextBlock Text="📱 Remote companion (phone → PC)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"
                                      Text="HTTP API on this PC for text chat and optional voice (STT on PC). Bind to loopback and use Tailscale / Cloudflare Tunnel for secure remote access. Video can be added later. Restart House Victoria after enabling or changing port/token."/>
                            <CheckBox IsChecked="{Binding RemoteCompanionEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"
                                     Content="Enable remote companion API"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Listen port:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding RemoteCompanionListenPort, UpdateSourceTrigger=PropertyChanged}"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="API token:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding RemoteCompanionApiToken, UpdateSourceTrigger=PropertyChanged}"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"
                                        ToolTip="Use at least 16 characters. Send as Authorization: Bearer &lt;token&gt; or X-Api-Key header."/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI contact ID:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding RemoteCompanionAiContactId, UpdateSourceTrigger=PropertyChanged}"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"
                                        ToolTip="Optional. Leave empty to use the primary AI contact."/>
                            </Grid>
                            <CheckBox IsChecked="{Binding RemoteCompanionListenOnLan}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4"
                                     Content="Listen on all interfaces (LAN) — off = loopback only (safer with a tunnel)"/>
                            <CheckBox IsChecked="{Binding RemoteCompanionNotifyUnreal}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2"
                                     Content="Notify Unreal after each reply (JSON command companion_remote_exchange)"/>
                        </StackPanel>
                    </Border>

                    <!-- LLM Servers: LM Studio, Ollama, Anything LLM (single block, one primary) -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=intelligence}">
                        <StackPanel>
                            <TextBlock Text="🧠 LLM Servers" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock Text="Pick a provider, then configure its endpoint in the panel below. Only one provider can be primary at a time." 
                                      FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
