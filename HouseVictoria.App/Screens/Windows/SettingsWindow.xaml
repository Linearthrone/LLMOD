                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Embedding model:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding OllamaEmbeddingModel, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Ollama model for /api/embed (e.g. nomic-embed-text). Pull with: ollama pull nomic-embed-text"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vector dimensions:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding EmbeddingVectorDimensions, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Must match the embedding model (768 for nomic-embed-text)."
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hybrid lexical weight:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="5,0">
                                    <Slider Minimum="0" Maximum="1" Value="{Binding HybridLexicalWeight}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                           Foreground="{DynamicResource PrimaryBrush}" Background="#CC222222"/>
                                    <TextBlock Text="{Binding HybridLexicalWeight, StringFormat='Lexical weight: {0:F2} (vector = 1 − this)'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Advanced: configuration vault -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=advanced}">
                        <StackPanel>
                            <TextBlock Text="Configuration vault" Style="{StaticResource SettingsSectionTitle}"/>
                            <TextBlock Text="Export a portable snapshot of all endpoints, themes, and autonomy settings. Import merges values from a saved JSON file. Reset restores factory defaults."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GlassButton}" Content="Import snapshot"
                                        Command="{Binding ImportSettingsCommand}" Height="36" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource GlassButton}" Content="Export snapshot"
                                        Command="{Binding ExportSettingsCommand}" Height="36" Margin="3,0"/>
                                <Button Grid.Column="2" Style="{StaticResource GlassButton}" Content="Reset to defaults"
                                        Command="{Binding ResetToDefaultsCommand}" Height="36" Margin="6,0,0,0"/>
                            </Grid>
                            <Separator Margin="0,14" Background="{DynamicResource BorderSubtleBrush}"/>
                            <TextBlock Text="Diagnostics" Style="{StaticResource SettingsSectionTitle}"/>
                            <TextBlock Text="{Binding PrimaryLLM, StringFormat='Primary LLM: {0}'}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding PersistentMemoryPath, StringFormat='Memory store: {0}'}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Autonomy loop -->
                    <Border Style="{StaticResource SettingsSectionCard}"
                            Visibility="{Binding SelectedSettingsCategory, Converter={StaticResource SettingsCategoryVisibilityConverter}, ConverterParameter=autonomy}">
                        <StackPanel>
                            <TextBlock Text="🫀 Autonomy &amp; cognition vitals" FontSize="16" FontWeight="Bold" Foreground="#F48FB1"/>
                            <Separator Margin="0,5" Background="#1A2332"/>
                            <TextBlock Text="Background loop and heart-monitor rhythm in the left instrument stack → Vitals tab."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Enable autonomy:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding EnableAutonomy}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="5,0"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tick interval (s):" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <Slider Minimum="30" Maximum="600" Value="{Binding AutonomyTickIntervalSeconds}"
                                           TickFrequency="30" IsSnapToTickEnabled="True"
                                           Foreground="#F48FB1" Background="#CC222222"/>
                                    <TextBlock Text="{Binding AutonomyTickIntervalSeconds, StringFormat='Every {0} seconds'}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Idle before hobbies:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <Slider Minimum="1" Maximum="30" Value="{Binding AutonomyMinIdleMinutes}"
                                           TickFrequency="1" IsSnapToTickEnabled="True"
                                           Foreground="#B388FF" Background="#CC222222"/>
                                    <TextBlock Text="{Binding AutonomyMinIdleMinutes, StringFormat={}{0} min without chat}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="High priority ≥:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <Slider Minimum="1" Maximum="10" Value="{Binding AutonomyHighPriorityThreshold}"
                                           TickFrequency="1" IsSnapToTickEnabled="True"
                                           Foreground="#FF4081" Background="#CC222222"/>
                                    <TextBlock Text="{Binding AutonomyHighPriorityThreshold, StringFormat='Project priority {0}+'}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max actions/hour:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <Slider Minimum="1" Maximum="24" Value="{Binding AutonomyMaxActionsPerHour}"
                                           TickFrequency="1" IsSnapToTickEnabled="True"
                                           Foreground="{DynamicResource PrimaryBrush}" Background="#CC222222"/>
                                    <TextBlock Text="{Binding AutonomyMaxActionsPerHour, StringFormat='{}{0} per hour'}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max art/hour:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="5,0">
                                    <Slider Minimum="0" Maximum="6" Value="{Binding AutonomyMaxArtPerHour}"
                                           TickFrequency="1" IsSnapToTickEnabled="True"
                                           Foreground="#F48FB1" Background="#CC222222"/>
                                    <TextBlock Text="{Binding AutonomyMaxArtPerHour, StringFormat='{}{0} ComfyUI runs/hour'}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Art on idle:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding AutonomyEnableArtGeneration}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,0"/>
                            </Grid>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="AI contact id:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding AutonomyAiContactId, UpdateSourceTrigger=PropertyChanged}"
                                        Background="{DynamicResource DarkInputBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="8" Margin="5,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Sticky footer -->
            <Border Grid.Row="2" Style="{StaticResource SettingsFooterBar}" Margin="12,8,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,4" Padding="8,6"
                                Background="#33FF3366" BorderBrush="#FF3366" BorderThickness="1"
                                Visibility="{Binding ValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11"/>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="8,6"
                                Background="#3300FF88" BorderBrush="#00FF88" BorderThickness="1"
                                Visibility="{Binding ConnectionTestResult, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ConnectionTestResult}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GlassButton}" 
                               Content="Reset" 
                               Command="{Binding ResetToDefaultsCommand}"
                               Width="100" Height="34" Margin="0,0,8,0"
                               ToolTip="Reset all settings to default values"/>
                        <Button Style="{StaticResource GlassButton}" 
                               Content="Import" 
                               Command="{Binding ImportSettingsCommand}"
                               Width="100" Height="34" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GlassButton}" 
                               Content="Export" 
                               Command="{Binding ExportSettingsCommand}"
                               Width="100" Height="34" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource GlassButton}" 
                               Content="Save Configuration" 
                               Click="SaveButton_Click"
                               Width="180" Height="34"
                               IsEnabled="{Binding IsValid}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

</Window>
