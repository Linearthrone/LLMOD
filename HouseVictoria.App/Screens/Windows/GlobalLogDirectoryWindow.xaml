<Window x:Class="HouseVictoria.App.Screens.Windows.GlobalLogDirectoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="Global Log Directory (GLD)" Height="800" Width="1400"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter"/>
    </Window.Resources>

    <Border Style="{StaticResource GlassPanel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with Close Button -->
        <Border Grid.Row="0"
                Style="{StaticResource OverlayPanelHeader}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="📋 Global Log Directory (GLD)"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Review inbox — select an item, then Archive when done"
                               FontSize="11"
                               Foreground="#80C4D4"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Refresh"
                            Style="{StaticResource GlassButton}"
                            MinWidth="70" Height="28"
                            Margin="0,0,5,0"
                            Click="RefreshButton_Click"/>

                    <ToggleButton IsChecked="{Binding ShowArchived, Mode=TwoWay}"
                                  Content="Show Archived"
                                  MinWidth="110" Height="28"
                                  Margin="5,0,5,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontSize="12"
                                  Cursor="Hand"
                                  ToolTip="Include archived items so you can review or restore them">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="#3000D4FF"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="8,0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5000D4FF"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#8000D4FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Button Content="Archive All"
                            Style="{StaticResource GlassButton}"
                            MinWidth="85" Height="28"
                            Margin="5,0,5,0"
                            Click="MarkAllReadButton_Click"
                            ToolTip="Acknowledge and archive every item in the inbox"/>

                    <Button Content="Archive"
                            Style="{StaticResource GlassButton}"
                            MinWidth="70" Height="28"
                            Margin="5,0,5,0"
                            Command="{Binding ArchiveSelectedCommand}"
                            ToolTip="Archive the selected item without opening it"/>

                    <Button Content="Restore"
                            Style="{StaticResource GlassButton}"
                            MinWidth="70" Height="28"
                            Margin="5,0,5,0"
                            Command="{Binding UnarchiveSelectedCommand}"
                            Visibility="{Binding SelectedIsArchived, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Restore the selected archived item back to the inbox (marks it unread)"/>

                    <Button Content="Export"
                            Style="{StaticResource GlassButton}"
                            MinWidth="60" Height="28"
                            Margin="5,0,5,0"
                            Click="ExportButton_Click"/>

                    <Button Content="−" 
                           Width="30" Height="30" 
                           Background="#4000D4FF" 
                           BorderThickness="0"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="Hand"
                           Margin="5,0,5,0"
                           Click="MinimizeButton_Click"
                           ToolTip="Minimize to Tray">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#6000D4FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" 
                           Width="30" Height="30" 
                           Background="#40FF3366" 
                           BorderThickness="0"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="Hand"
                           Margin="0,0,0,0"
                           Click="CloseButton_Click"
                           ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                   CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#60FF3366"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Split Panel Content -->
        <Grid Grid.Row="1" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TreeView - Left Panel -->
            <Border Grid.Column="0" 
                    Style="{StaticResource Card}"
                    Margin="5">
                <Grid>
                    <!-- Loading Indicator -->
                    <StackPanel x:Name="LoadingPanel" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading logs..." 
                                   Foreground="White" 
                                   FontSize="14" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <ProgressBar IsIndeterminate="True" 
                                     Width="200" 
                                     Height="4"/>
                    </StackPanel>
                    
                    <!-- TreeView -->
                    <TreeView x:Name="LogTreeView"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="13"
                              ItemsSource="{Binding Categories}"
                              SelectedItemChanged="LogTreeView_SelectedItemChanged"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <TextBlock Foreground="#00D4FF" 
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <!-- Default: show the unread badge -->
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="{Binding UnreadCount, StringFormat=' ({0} unread)'}"/>
                                            <Style.Triggers>
                                                <!-- Hide when UnreadCount is exactly 0 -->
                                                <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}" 
                                          Foreground="#CCB0BEC5" 
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4000D4FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#4000D4FF"/>
                                    <Setter Property="Foreground" Value="#E0F7FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                         Width="5" 
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Stretch" 
                         Background="#4000D4FF"
                         ShowsPreview="True"/>

            <!-- Log Details - Right Panel -->
            <Border Grid.Column="2" 
                    Style="{StaticResource Card}"
                    Margin="5">
                    <Grid>
                        <TextBlock x:Name="NoSelectionHint"
                                   Text="Select a log entry to view details"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontStyle="Italic"
                                   Foreground="#80C4D4"/>

                        <Grid x:Name="LogDetailsPanel" Visibility="Collapsed" Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Log Title -->
                            <Border Grid.Row="0" 
                                    Background="#4000D4FF" 
                                    Padding="10" 
                                    CornerRadius="5" 
                                    Margin="0,0,0,10"
                                    BorderBrush="#6000D4FF"
                                    BorderThickness="1">
                                <TextBlock x:Name="LogTitle"
                                           Text="Log Title"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>

                            <!-- Log Metadata -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Style="{StaticResource Card}"
                                        Padding="10" 
                                        Margin="0,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="Date/Time" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="LogDateTime" Text="2026-01-04 14:32:15" FontSize="12" Foreground="#80C4D4"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" 
                                        Style="{StaticResource Card}"
                                        Padding="10" 
                                        Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="Severity" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="LogSeverity" Text="Info" FontSize="12" Foreground="#80C4D4"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" 
                                        Style="{StaticResource Card}"
                                        Padding="10" 
                                        Margin="2,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Source" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock x:Name="LogSource" Text="AI Service" FontSize="12" Foreground="#80C4D4"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Log Tags -->
                            <Border Grid.Row="2" 
                                    Style="{StaticResource Card}"
                                    Padding="10" 
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Tags" FontWeight="Bold" FontSize="11" Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ItemsControl x:Name="LogTags">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#4000D4FF" 
                                                        Padding="8,4" 
                                                        Margin="0,0,5,5" 
                                                        CornerRadius="3"
                                                        BorderBrush="#6000D4FF"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding}" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                                               FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Log Summary -->
                            <Border Grid.Row="3" 
                                    Style="{StaticResource Card}"
                                    Padding="10" 
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Summary" FontWeight="Bold" FontSize="11" Margin="0,0,0,5" Foreground="#00D4FF"/>
                                    <TextBlock x:Name="LogSummary" 
                                               Text="This is a summary of the log entry that provides a quick overview of what happened..."
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Linked Files -->
                            <Border Grid.Row="4"
                                    x:Name="LinkedFilesPanel"
                                    Style="{StaticResource Card}"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Linked Files" FontWeight="Bold" FontSize="11" Margin="0,0,0,5" Foreground="#00D4FF"/>
                                    <ItemsControl x:Name="LogLinkedFiles">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding DisplayName}"
                                                        Tag="{Binding Path}"
                                                        Click="LinkedFileButton_Click"
                                                        Cursor="Hand"
                                                        HorizontalContentAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0,2"
                                                        Foreground="#80DEEA"
                                                        FontSize="12"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Image Previews -->
                            <Border Grid.Row="5"
                                    x:Name="ImagePreviewPanel"
                                    Style="{StaticResource Card}"
                                    Padding="10"
                                    Margin="0,0,0,10"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Image Preview" FontWeight="Bold" FontSize="11" Margin="0,0,0,5" Foreground="#00D4FF"/>
                                    <ScrollViewer MaxHeight="320"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Style="{StaticResource ModernScrollViewer}">
                                        <ItemsControl x:Name="ImagePreviews">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,8,8"
                                                            Padding="4"
                                                            CornerRadius="5"
                                                            Background="#2000D4FF"
                                                            BorderBrush="#4000D4FF"
                                                            BorderThickness="1">
                                                        <StackPanel>
                                                            <Border CornerRadius="4" ClipToBounds="True" Cursor="Hand">
                                                                <Image Source="{Binding Path, Converter={StaticResource FilePathToImageSourceConverter}}"
                                                                       MaxHeight="240"
                                                                       MaxWidth="320"
                                                                       Stretch="Uniform"
                                                                       Tag="{Binding Path}"
                                                                       MouseLeftButtonUp="ImagePreview_MouseLeftButtonUp"
                                                                       ToolTip="{Binding Path}"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       Foreground="#80C4D4"
                                                                       FontSize="10"
                                                                       MaxWidth="320"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="2,4,2,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- Log Content -->
                            <Border Grid.Row="6" 
                                    Style="{StaticResource Card}"
                                    Padding="10" 
                                    Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" 
                                               Text="Full Log Content" 
                                               FontWeight="Bold" 
                                               FontSize="11" 
                                               Margin="0,0,0,5"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    
                                    <ScrollViewer Grid.Row="1" 
                                                VerticalScrollBarVisibility="Auto"
                                                HorizontalScrollBarVisibility="Disabled"
                                                Style="{StaticResource ModernScrollViewer}">
                                        <TextBox x:Name="LogContent"
                                                 Text="Full log content appears here..."
                                                 TextWrapping="Wrap"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="False"
                                                 Focusable="False"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FontFamily="Consolas"
                                                 FontSize="11"
                                                 Foreground="#80C4D4"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 HorizontalScrollBarVisibility="Disabled"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
