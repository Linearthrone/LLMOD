<Window x:Class="HouseVictoria.App.Screens.Windows.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Agent" Height="360" Width="520"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Border Style="{StaticResource OverlayPanelShell}" Margin="12">
        <Border Style="{StaticResource GlassPanel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource OverlayPanelHeader}">
                    <TextBlock Text="Cognitive Agent" Style="{StaticResource OverlayPanelTitle}"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="16,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Name" Width="96" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding State.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Goal" Width="96" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding State.CurrentGoal}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Last action" Width="96" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding State.LastAction}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Drives" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DrivesSummary}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Step" Style="{StaticResource GlassButton}" Width="88" Margin="0,0,8,0"
                                Command="{Binding StepCommand}"/>
                        <Button Content="Close" Style="{StaticResource OverlayCloseButton}" Width="88" IsCancel="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
