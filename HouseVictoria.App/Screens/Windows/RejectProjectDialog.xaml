<Window x:Class="HouseVictoria.App.Screens.Windows.RejectProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
        mc:Ignorable="d"
        Title="Send Project Back for Revision" Height="720" Width="720" MinHeight="720" MinWidth="640"
        Style="{StaticResource OverlayWindow}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="DatePicker" BasedOn="{StaticResource MaterialDesignDatePicker}">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CalendarDayButton">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0BEC5"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#9575CD"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#673AB7"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="BorderBrush" Value="#673AB7"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CalendarItem">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="CalendarButton">
            <Setter Property="Background" Value="#383838"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource GlassPanel}" Background="#CC1a1a2e">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Opacity="0.9" Padding="15,12"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="✋ Send Back for Revision" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding ProjectName}" FontSize="12" Foreground="#E0E0F0" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- What was wrong -->
                    <TextBlock Text="What was wrong with the project?" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource DarkInputBrush}" BorderBrush="#B0BEC5" BorderThickness="1"
                             Foreground="White" Padding="8" Margin="0,6,0,16"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Suggestions -->
                    <TextBlock Text="How should she fix or improve it?" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBox Text="{Binding Suggestions, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource DarkInputBrush}" BorderBrush="#B0BEC5" BorderThickness="1"
                             Foreground="White" Padding="8" Margin="0,6,0,16"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                             VerticalScrollBarVisibility="Auto"/>

                    <!-- Priority -->
                    <TextBlock Text="Priority for the re-started project" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <Slider Minimum="1" Maximum="10" Value="{Binding Priority}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Foreground="#e94560" Background="#CC222222" Margin="0,8,0,2"/>
                    <TextBlock Text="{Binding Priority, StringFormat='Priority: {0:F0}'}"
                               Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,16"/>

                    <!-- New dates -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="New start date" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <DatePicker SelectedDate="{Binding NewStartDate}"
                                        Style="{StaticResource MaterialDesignDatePicker}"
                                        Background="{StaticResource DarkInputBrush}" BorderBrush="#B0BEC5" BorderThickness="1"
                                        Foreground="White" Padding="8" Margin="0,6,0,0" Height="34">
                                <DatePicker.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource DarkInputBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="New deadline" FontSize="14" FontWeight="Bold" Foreground="White"/>
                            <DatePicker SelectedDate="{Binding NewDeadline}"
                                        Style="{StaticResource MaterialDesignDatePicker}"
                                        Background="{StaticResource DarkInputBrush}" BorderBrush="#B0BEC5" BorderThickness="1"
                                        Foreground="White" Padding="8" Margin="0,6,0,0" Height="34">
                                <DatePicker.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Background" Value="{StaticResource DarkInputBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ValidationError}"
                               Foreground="#FF6B6B" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding ValidationError, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#CC222222" Padding="15,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GlassButton}" Content="✋ Send Back"
                            Width="140" Height="35" Margin="0,0,10,0"
                            Click="SubmitButton_Click"/>
                    <Button Style="{StaticResource GlassButton}" Content="❌ Cancel"
                            Width="120" Height="35"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
