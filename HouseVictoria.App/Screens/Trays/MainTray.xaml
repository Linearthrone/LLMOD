<UserControl x:Class="HouseVictoria.App.Screens.Trays.MainTray"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="80">

    <Grid x:Name="RootGrid" Background="Transparent" MouseLeave="RootGrid_MouseLeave">
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Expanded dock -->
            <Border Grid.Column="0"
                    Style="{StaticResource GlassTrayContainer}"
                    MinWidth="72"
                    Padding="8,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Border Style="{StaticResource RefractionGlow}"/>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <Button Style="{StaticResource DockButton}"
                                ToolTip="SMS / MMS"
                                Command="{Binding OpenSMSCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource Mdl2Icon}" FontSize="18"/>
                                <TextBlock Text="Comms" Style="{StaticResource DockButtonLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DockButton}"
                                ToolTip="AI Models &amp; Personas"
                                Command="{Binding OpenAIModelsCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xE99A;" Style="{StaticResource Mdl2Icon}" FontSize="18"/>
                                <TextBlock Text="Mind" Style="{StaticResource DockButtonLabel}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource DockButton}"
                                ToolTip="Settings"
                                Command="{Binding OpenSettingsCommand}">
                            <StackPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource Mdl2Icon}" FontSize="18"/>
                                <TextBlock Text="System" Style="{StaticResource DockButtonLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Slim pull-tab -->
            <Border Grid.Column="1"
                    Style="{StaticResource InstrumentPullTab}"
                    Width="8"
                    Height="160"
                    VerticalAlignment="Center"
                    Margin="0">
                <ToggleButton Width="8"
                              Height="160"
                              Padding="0"
                              BorderThickness="0"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              Background="Transparent">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource TrayToggleButton}">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Height" Value="160"/>
                            <Setter Property="ToolTip" Value="Expand dock"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="ToolTip" Value="Collapse dock"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <Border Width="2" Height="32" CornerRadius="1"
                            Background="{DynamicResource PrimaryBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
            </Border>
        </Grid>
    </Grid>

</UserControl>
