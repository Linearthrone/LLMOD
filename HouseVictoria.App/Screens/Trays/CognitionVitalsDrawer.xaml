<UserControl x:Class="HouseVictoria.App.Screens.Trays.CognitionVitalsDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
             xmlns:controls="clr-namespace:HouseVictoria.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="320"
             Unloaded="Control_Unloaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseDown="RootGrid_MouseDown">
        <!-- Minimal edge handle -->
        <Button x:Name="CollapsedPullHandle"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="14"
                Height="72"
                Margin="0,8,0,0"
                Command="{Binding ExpandFromHandleCommand}"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                ToolTip="Show cognition pulse"
                Visibility="{Binding IsHandleMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#2000D4FF"
                            BorderBrush="#4000D4FF"
                            BorderThickness="1,1,0,1"
                            CornerRadius="0,8,8,0">
                        <TextBlock Text="⮞"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#8000D4FF"
                                   FontSize="10"
                                   FontFamily="Segoe UI"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Compact pulse widget (no name) -->
        <Border x:Name="PulseWidget"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="132"
                Background="#CC0A0E27"
                BorderBrush="#4000D4FF"
                BorderThickness="1"
                CornerRadius="0,8,8,0"
                Padding="6"
                Cursor="Hand"
                ToolTip="Click: open vitals · Double-click: hide to handle"
                Visibility="{Binding IsPulseMode, Converter={StaticResource BoolToVisibilityConverter}}"
                MouseLeftButtonDown="PulseWidget_MouseLeftButtonDown">
            <StackPanel>
                <controls:CognitionVitalsControl Margin="0,0,0,2"
                                                   WaveHeight="40"
                                                   Rhythm="{Binding CognitionRhythm}"
                                                   BeatsPerMinute="{Binding CognitionBpm}"
                                                   Intensity="{Binding CognitionIntensity}"
                                                   WaveColorHex="{Binding CognitionWaveColorHex}"/>
                <TextBlock Text="{Binding CognitionRhythmDescription}"
                           FontSize="9"
                           Foreground="#80C4D4"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Expanded drawer panel -->
        <Border x:Name="DrawerPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Width="300"
                Background="#CC0A0E27"
                CornerRadius="6"
                Padding="10"
                BorderBrush="#4000D4FF"
                BorderThickness="1"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel>
                    <Border Background="Transparent"
                            BorderThickness="0"
                            Padding="0,0,0,8"
                            Cursor="Hand"
                            ToolTip="Collapse to handle"
                            MouseLeftButtonDown="DrawerHeaderPulse_MouseLeftButtonDown">
                        <StackPanel>
                            <controls:CognitionVitalsControl Margin="0,0,0,4"
                                                               WaveHeight="56"
                                                               Rhythm="{Binding CognitionRhythm}"
                                                               BeatsPerMinute="{Binding CognitionBpm}"
                                                               Intensity="{Binding CognitionIntensity}"
                                                               WaveColorHex="{Binding CognitionWaveColorHex}"/>
                            <TextBlock Text="{Binding CognitionRhythmDescription}"
                                       FontSize="11"
                                       Foreground="#80C4D4"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,5">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Autonomy" FontSize="14" Foreground="#F48FB1" FontWeight="Bold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Command="{Binding CycleAutonomyLevelCommand}"
                                            MinWidth="52"
                                            Height="24"
                                            Padding="8,2"
                                            Margin="0,0,6,0"
                                            Background="#3320B2FF"
                                            BorderBrush="#6000D4FF"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            ToolTip="Click to cycle autonomy level">
                                        <TextBlock Text="{Binding AutonomyLevelLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E0F7FF"/>
                                    </Button>
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding CognitionWaveColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                    <TextBlock Text="{Binding AutonomyStatusText}" FontSize="11" Foreground="#E0F7FF"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Guidance (if stuck or fixated)" FontSize="11" Foreground="#80C4D4" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding AutonomySuggestion, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="28"
                                         Padding="6,4"
                                         FontSize="11"
                                         Foreground="#E0F7FF"
                                         Background="#1A152535"
                                         BorderBrush="#4000D4FF"
                                         BorderThickness="1"
                                         AcceptsReturn="False"
                                         VerticalContentAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="ToolTip" Value="e.g. Try research on a new topic, or switch to art"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Command="{Binding ApplyAutonomySuggestionCommand}"
                                        Margin="6,0,0,0"
                                        Padding="8,4"
                                        Background="#3320B2FF"
                                        BorderBrush="#6000D4FF"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        ToolTip="Apply guidance to next autonomy decisions">
                                    <TextBlock Text="Apply" FontSize="10" Foreground="#E0F7FF"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="Current activity" FontSize="11" Foreground="#80C4D4" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding CurrentActivityElapsed}" FontSize="12" Foreground="#00D4FF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentActivityDescription}" FontSize="12" Foreground="#E0F7FF"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Last activity" FontSize="11" Foreground="#80C4D4" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding PreviousActivityDescription}" FontSize="12" Foreground="#E0F7FF"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#607080">
                                <Run Text="Duration: "/>
                                <Run Text="{Binding PreviousActivityDuration}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
