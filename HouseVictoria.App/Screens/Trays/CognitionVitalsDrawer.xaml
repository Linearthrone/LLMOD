<UserControl x:Class="HouseVictoria.App.Screens.Trays.CognitionVitalsDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:HouseVictoria.App.Converters"
             xmlns:controls="clr-namespace:HouseVictoria.App.Controls"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="320"
             Unloaded="Control_Unloaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseDown="RootGrid_MouseDown">
        <!-- Collapsed tab: active AI name only -->
        <Border x:Name="CollapsedTab"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#2000D4FF"
                BorderBrush="#4000D4FF"
                BorderThickness="1"
                CornerRadius="0,8,8,0"
                Padding="10,8"
                Cursor="Hand"
                Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <Button Command="{Binding ToggleDrawerCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ToolTip="Cognitive vitals">
                <TextBlock Text="{Binding ActiveAiName}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#E0F7FF"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160"/>
            </Button>
        </Border>

        <!-- Expanded drawer panel -->
        <Border x:Name="DrawerPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Width="300"
                Background="#CC0A0E27"
                CornerRadius="6"
                Padding="10"
                BorderBrush="#4000D4FF"
                BorderThickness="1"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                <StackPanel>
                    <Button Command="{Binding ToggleDrawerCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,0,0,8"
                            HorizontalContentAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Collapse vitals">
                        <TextBlock Text="{Binding ActiveAiName}"
                                   Style="{StaticResource CalligraphyText}"
                                   FontSize="22"
                                   Foreground="#E0F7FF"/>
                    </Button>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,5"
                            BorderBrush="{Binding CognitionWaveColorHex, Converter={StaticResource HexToBrushConverter}}">
                        <StackPanel>
                            <TextBlock Text="Pulse" FontSize="14" Foreground="#00D4FF" FontWeight="Bold"/>
                            <controls:CognitionVitalsControl Margin="0,8,0,4"
                                                               WaveHeight="72"
                                                               Rhythm="{Binding CognitionRhythm}"
                                                               BeatsPerMinute="{Binding CognitionBpm}"
                                                               Intensity="{Binding CognitionIntensity}"
                                                               WaveColorHex="{Binding CognitionWaveColorHex}"/>
                            <TextBlock Text="{Binding CognitionRhythmDescription}"
                                       FontSize="11"
                                       Foreground="#80C4D4"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,5">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Autonomy" FontSize="14" Foreground="#F48FB1" FontWeight="Bold"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Fill="{Binding CognitionWaveColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                    <TextBlock Text="{Binding AutonomyStatusText}" FontSize="11" Foreground="#E0F7FF"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Current activity" FontSize="11" Foreground="#80C4D4" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding CurrentActivityElapsed}" FontSize="12" Foreground="#00D4FF" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentActivityDescription}" FontSize="12" Foreground="#E0F7FF"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Last activity" FontSize="11" Foreground="#80C4D4" Margin="0,10,0,2"/>
                            <TextBlock Text="{Binding PreviousActivityDescription}" FontSize="12" Foreground="#E0F7FF"
                                       TextWrapping="Wrap"/>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#607080">
                                <Run Text="Duration: "/>
                                <Run Text="{Binding PreviousActivityDuration}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
