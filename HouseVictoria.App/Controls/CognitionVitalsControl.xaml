<UserControl x:Class="HouseVictoria.App.Controls.CognitionVitalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Background="Transparent">
    <Grid>
        <Border Background="#120A1220" CornerRadius="4" BorderBrush="#4000D4FF" BorderThickness="1" Padding="4,2">
            <Grid>
                <Canvas x:Name="WaveCanvas" ClipToBounds="True" Height="{Binding ElementName=Root, Path=WaveHeight}"/>
                <Border Background="#660A0E27" VerticalAlignment="Bottom" Padding="4,1" CornerRadius="0,0,3,3">
                    <TextBlock x:Name="BpmLabel"
                               FontSize="9"
                               Foreground="#80C4D4"
                               HorizontalAlignment="Right"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
